@using InformatikaiEszkozok.WEB.SERVICE
@inject KosarService kosarService

<div class="rendeles-doboz h-100">
    <div class="d-flex justify-content-between align-items-center">
        <h3>Rendelési kosár</h3>

        @if (kosarService.Tetelek.Any())
        {
            <button class="btn btn-outline-danger btn-sm"
                    type="button"
                    @onclick="KosarUritese">
                Kosár ürítése
            </button>
        }
    </div>

    <p>A kiválasztott termékek összesítése.</p>

    <hr />

    @if (!kosarService.Tetelek.Any())
    {
        <div class="alert alert-warning">
            A kosár jelenleg üres.
        </div>
    }
    else
    {
        @foreach (var tetel in kosarService.Tetelek)
        {
            <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                <div>
                    <strong>@tetel.Nev</strong>
                    <span class="ms-2">
                        @tetel.Mennyiseg db × @tetel.Egysegar.ToString("N0") Ft
                    </span>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <strong>
                        @((tetel.Mennyiseg * tetel.Egysegar).ToString("N0")) Ft
                    </strong>

                    <button class="btn btn-outline-danger btn-sm"
                            type="button"
                            @onclick="() => TetelTorlese(tetel.TermekId)">
                        Eltávolítás
                    </button>
                </div>
            </div>
        }

        <div class="osszesites-doboz mt-4 p-3 rounded">
            <p>Összesen: @Osszesen.ToString("N0") Ft</p>
            <p>Kedvezmény: @Kedvezmeny.ToString("N0") Ft</p>
            <h5>Fizetendő: @Fizetendo.ToString("N0") Ft</h5>
        </div>
    }
</div>

@code {
    [Parameter]
    public bool Kedvezmenyes { get; set; }

    private int Osszesen => kosarService.Tetelek.Sum(tetel => tetel.Egysegar * tetel.Mennyiseg);

    private int Kedvezmeny => Kedvezmenyes ? Osszesen * 20 / 100 : 0;

    private int Fizetendo => Osszesen - Kedvezmeny;

    /// <summary>
    /// Kiüríti a teljes kosarat.
    /// </summary>
    private void KosarUritese()
    {
        kosarService.Urit();
    }

    /// <summary>
    /// Eltávolít egy tételt a kosárból.
    /// </summary>
    /// <param name="termekId">Az eltávolítandó termék azonosítója.</param>
    private void TetelTorlese(int termekId)
    {
        kosarService.TetelTorles(termekId);
    }
}