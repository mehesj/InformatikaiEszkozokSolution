@page "/rendeles"

@using InformatikaiEszkozok.WEB.Components
@using InformatikaiEszkozok.WEB.SERVICE

@inject KosarService kosarService

<PageTitle>Rendelés véglegesítése</PageTitle>

<section class="kiemelt-szekcio py-5">
    <div class="container">

        <div class="text-center mb-4">
            <h2>Rendelés véglegesítése</h2>
            <p class="bevezeto-szoveg">
                Ellenőrizze a kosár tartalmát, majd adja meg a rendeléshez szükséges adatokat.
            </p>
        </div>

        <div class="row g-4">

            <!-- BAL OLDAL -->
            <div class="col-12 col-lg-5">
                <VasarloComponent @bind-Kedvezmenyes="kedvezmenyes" />
            </div>

            <!-- JOBB OLDAL -->
            <div class="col-12 col-lg-7">
                <KosarComponent Kedvezmenyes="kedvezmenyes" />
            </div>

        </div>

    </div>
</section>

@code {
    private bool kedvezmenyes = false;
}