@page "/"
@using InformatikaiEszkozok.WEB.ViewModel
@using InformatikaiEszkozok_LIB
@using InformatikaiEszkozok_LIB.MODEL

<PageTitle>Home</PageTitle>


<header class="hero-szekcio">
    <div class="container hero-tartalom text-center">
        <h1>Informatikai termékbolt</h1>  @* 3. feladat  Eredetileg hiányzik a nyitó tag*@
         
            Válassza ki a megvásárolható informatikai termékeket, tegye őket a kosárba,
            majd adja le a rendelését.
           
        <div class="d-flex justify-content-center gap-3 flex-wrap mt-4">

            @* 3. feladat  Menü beállítása*@
            <!-- Termékek (oldalon belüli ugrás) -->
            <a href="#termekek" class="btn btn-sajat btn-lg px-5">
                Termékek megtekintése
            </a>

            <!-- Rendelés oldal -->
            <NavLink href="/rendeles" class="btn btn-vilagos btn-lg px-5">
                Kosár megnyitása
            </NavLink>
        </div>
    </div>
</header> 

<main>
    <!-- ===================================================== -->
    <!-- MŰKÖDÉS                                               -->
    <!-- ===================================================== -->
    <section id="mukodes" class="tartalmi-szekcio">         @* 4. feladat  mukodes azonosító*@
        <div class="container">                             @* 4. feladat  Container stílus*@

            <div class="text-center mb-5 mx-auto" style="max-width: 700px;">   @* 4. feladat  Középre tervezett, alsó margó 5*@
                <h2>Hogyan működik?</h2>
                <p>
                    A vásárló megtekinti a termékeket, kiválasztja a kívánt mennyiséget,
                    majd a rendelés oldalon véglegesíti a vásárlást.
                </p>
            </div>

            <div class="row g-4">  @* 5. feladat  Minta szerinti elrendezés (Térköz)*@

                <div class="col-12 col-md-6 col-lg-4">   @* 5. feladat  Rács viselkedése*@
                    <div class="info-doboz h-100 shadow-sm">
                        <h3>1. Termékek megtekintése</h3>
                        <p>
                            A rendszer megjeleníti az adatbázisban tárolt termékeket,
                            azok árát, készletét és rövid leírását.
                        </p>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="info-doboz h-100 shadow-sm">
                        <h3>2. Kosár összeállítása</h3>
                        <p>
                            A vásárló megadja a kívánt mennyiséget, majd a terméket
                            a kosárba helyezi.
                        </p>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="info-doboz h-100 shadow-sm">
                        <h3>3. Rendelés leadása</h3>
                        <p>
                            A rendelés oldalon a vásárló megadja az adatait. Érvényes
                            diákazonosító esetén 20% kedvezményt kap.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>


    <!-- ===================================================== -->
    <!-- TERMÉKEK                                              -->
    <!-- ===================================================== -->
    <section id="termekek" class="kiemelt-szekcio py-5">
        <div class="container">
            <div class="text-center mb-4">
                <h2>Termékek</h2>
                <p class="bevezeto-szoveg">
                    A termékek lekérdezése után megjelennek a megvásárolható informatikai termékek.
                </p>

                <button id="termekekLekerdezesGomb"
                        class="btn btn-sajat mt-3"
                        type="button"
                        @onclick="TermekekBetoltese">
                    Termékek lekérdezése
                </button>
            </div>

            <div id="termekKartyaTarolo" class="row g-4">
                @* Ide jönnek majd az API-ból érkező termékkártyák *@
                @foreach (var t in termekek)
                {
                    <div class="col-lg-3 col-md-6">
                        <div class="card h-100 shadow-sm">

                            <img src="img/@t.KepFajlnev"
                                 class="card-img-top"
                                 alt="@t.Nev" />

                            <div class="card-body">
                                <h5 class="card-title">@t.Nev</h5>

                                <p class="card-text">
                                    Egységár: @t.Egysegar Ft<br />
                                    Készleten: @t.Keszlet db
                                </p>

                                <p class="card-text small text-muted">
                                    @t.Leiras
                                </p>
                            </div>

                            <div class="card-footer text-center">
                                <button class="btn btn-sajat w-100"
                                        type="button"
                                        data-bs-toggle="modal"
                                        data-bs-target="#termekModal">
                                    Tovább
                                </button>
                            </div>

                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
</main>

<!-- ========================================================= -->
<!-- MODAL                                                    -->
<!-- ========================================================= -->
<div class="modal fade" id="termekModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <div>
                    <h5 class="modal-title">Termékek</h5>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Bezárás">
                </button>
            </div>

            <div class="modal-body">

                @foreach (var termek in termekek)
                {
                    <div class="d-flex justify-content-between align-items-center border-bottom py-2">

                        <div>
                            <strong>@termek.Nev</strong>
                            <span> – @termek.Egysegar Ft</span>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <input type="number"
                                   class="form-control form-control-sm text-center"
                                   style="width: 70px;"
                                   min="0" 
                                   max="@termek.Keszlet"
                                   @bind="mennyisegek[termek.Id]"
                                   @bind:event="oninput" />

                            @if (mennyisegek[termek.Id] > termek.Keszlet) // Ha a beírt mennyiség nagyobb, mint a készlet, akkor hibaüzenet jelenik meg
                            {
                                <small class="text-danger">
                                    Nincs elegendő készlet!
                                </small>
                            }
                            
                            <button class="btn btn-sajat btn-sm"
                                    disabled="@(mennyisegek[termek.Id] <= 0 || mennyisegek[termek.Id] > termek.Keszlet)" 
                                    @onclick="() => Kosarba(termek)">
                                Kosárba
                            </button>
                        </div>

                    </div>
                }

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-vilagos"
                        data-bs-dismiss="modal">
                    Bezárás
                </button>

                <NavLink href="/rendeles" class="btn btn-sajat">
                    Rendelés véglegesítése
                </NavLink>
            </div>

        </div>
    </div>
</div>

@code {
    private List<Termek> termekek = new();
    private List<KosarTetel> kosar = new();

    private Dictionary<int, int> mennyisegek = new();

    /// <summary>
    /// Lekéri az API-ból a termékeket, és minden termékhez létrehoz egy 0 kezdőmennyiséget.
    /// </summary>
    private async Task TermekekBetoltese()
    {
        termekek = await Worker.Termekek();

        foreach (var termek in termekek) // Minden termékhez létrehozunk egy 0 kezdőmennyiséget
        {
            mennyisegek[termek.Id] = 0;
        }
    }

    /// <summary>
    /// A kiválasztott terméket a megadott mennyiséggel a kosárba helyezi.
    /// </summary>
    /// <param name="termek">A kosárba helyezendő termék.</param>
    private void Kosarba(Termek termek)
    {
        int mennyiseg = mennyisegek[termek.Id];

        // Mennyiség ellenőrzés - Állapot késhet, lehet versenyhelyzet ( :) + biztosítás)
        if (mennyiseg <= 0) // Nem helyezünk a kosárba 0 vagy negatív mennyiséget
        {
            return;
        }

        if (mennyiseg > termek.Keszlet) // Nem helyezünk a kosárba a készletnél nagyobb mennyiséget
        {
            return;
        }

        var kosarTetel = kosar.FirstOrDefault(kosarTetel => kosarTetel.TermekId == termek.Id); // Van már a tétel?

        if (kosarTetel == null)
        {
            kosar.Add(new KosarTetel
            {
                TermekId = termek.Id,
                Nev = termek.Nev,
                Egysegar = termek.Egysegar,
                Mennyiseg = mennyiseg,
                KepFajlnev = termek.KepFajlnev
            });
        }
        else
        {
            if (kosarTetel.Mennyiseg + mennyiseg > termek.Keszlet)
            {
                return;
            }

            kosarTetel.Mennyiseg += mennyiseg;
        }

        mennyisegek[termek.Id] = 0;
    }
}
